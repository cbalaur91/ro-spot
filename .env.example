# Supabase management CLI (not shipped in the app)
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_REF=bnkwiqnatknsgkftouti

# Server-only. Used by integration tests to seed/inspect rows past RLS. Never ship this.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Shipped in the client bundle — safe to be public, RLS is the real boundary.
EXPO_PUBLIC_SUPABASE_URL=https://bnkwiqnatknsgkftouti.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Android only, and only for dev/production builds — the Google Maps SDK needs a
# key restricted to your signing certificate. iOS uses Apple Maps and needs none.
GOOGLE_MAPS_ANDROID_API_KEY=AIza...

# Crash reporting. The DSN from sentry.io → Project Settings → Client Keys (DSN).
# Public by design (it ships in the app); leave empty to run with Sentry off.
EXPO_PUBLIC_SENTRY_DSN=

# The hosted privacy policy, opened from the Profile tab. Leave empty and the link is hidden.
EXPO_PUBLIC_PRIVACY_URL=
